<?xml version="1.0" encoding="utf-8"?>
<!-- 권한 문자열을 실제 SDK jar 의 상수와 대조해 수정.
     Pleos Vehicle SDK 권한은 protectionLevel "normal" (샘플 앱 매니페스트 주석) 이라 런타임 요청 없이 선언만으로 쓴다.
     아래에 선언한 android.car.permission.* 중 CAR_SPEED·READ_CAR_PEDALS 는 dangerous(런타임 요청), CAR_POWERTRAIN·CAR_INFO 는 normal 이다.
     signature|privileged 등급은 선언하지 않는다. 거부되거나 속성이 없는 차량에서도 앱이 죽지 않게 PleosSignalSource·CarSpecLoader 에서 try/catch. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 자동차 앱 선언 (AAOS) -->
    <uses-feature android:name="android.hardware.type.automotive" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- ===== Pleos Vehicle SDK (읽기 전용 도메인만, 제어(CONTROL_*)는 쓰지 않는다) =====
         문자열은 Vehicle-2.3.2.jar 의 ai.pleos.playground.vehicle.constant.PleosPermission 상수와 각 메서드의 @RequiresPermission 을 javap 로 대조 -->
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />      <!-- Brake, Gear, SteeringWheel(조향각), Odometer, DrivingMode -->
    <uses-permission android:name="pleos.car.permission.CAR_LIGHTS" />     <!-- Light, TurnSignal -->
    <uses-permission android:name="pleos.car.permission.CAR_WINDOWS" />    <!-- Window, Wiper -->
    <uses-permission android:name="pleos.car.permission.CAR_DOORS" />      <!-- Door -->
    <uses-permission android:name="pleos.car.permission.CAR_CLIMATE" />    <!-- HVAC -->
    <uses-permission android:name="pleos.car.permission.CAR_SEATS" />      <!-- Seat -->
    <uses-permission android:name="pleos.car.permission.CAR_SAFETY" />     <!-- Safety 공개 항목(안전벨트 경고, 오일/브레이크액 레벨). Telltales 는 PRIVATE_CAR_SAFETY 라 제외 -->
    <uses-permission android:name="pleos.car.permission.CAR_ENERGY" />     <!-- Fuel -->
    <uses-permission android:name="pleos.car.permission.CAR_INFO" />       <!-- CarInfo(VIN) -->
    <!-- 공식 가이드 "제품 앱은 실제로 사용하는 typed API 의 최소 permission 만 선언. Sample App 전체 권한 목록을 그대로 복사하지 않는다"
         (tutorial/vehicle-sdk-sample-app, 심사 반려 사유 "불필요한 권한 요청") 에 따라, 샘플에서 따라 넣었던 11개
         (CAR_POWERTRAIN·CAR_MILEAGE·CAR_MIRRORS·CAR_SPEED·CAR_TOLL·CAR_TIRES·CAR_CONNECT_VENDOR_CONTROL·READ_CAR_STEERING·
          READ_WINDSHIELD_WIPERS·READ_ADAS_STATES·READ_CAR_DISPLAY_UNITS) 를 뺐다. 우리가 부르는 메서드의 @RequiresPermission 은 위 9개가 전부다. -->

    <!-- ===== Pleos NaviHelper / TTS / STT / FusedLocation ===== -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />         <!-- get*Info(), requestTrip() (NaviHelper-3.0.5 @RequiresPermission 확인) -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE_SEARCH" />  <!-- requestRoute*, addWaypoint, cancelRoute, requestReRoute, changeRouteOption (확인) -->
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />        <!-- TextToSpeech-3.3.1 @RequiresPermission 확인 -->
    <uses-permission android:name="pleos.car.permission.STT_SERVICE" />        <!-- SpeechToText-3.3.1 @RequiresPermission 확인 -->
    <uses-permission android:name="pleos.car.permission.FUSED_LOCATION" />     <!-- fused-location-data PleosPermission.FUSED_LOCATION 확인 -->

    <!-- ===== AAOS android.car (CarPropertyManager) =====
         PERF_VEHICLE_SPEED: CAR_SPEED (dangerous → 런타임 요청), GEAR_SELECTION / PARKING_BRAKE_ON / IGNITION_STATE: CAR_POWERTRAIN (normal).
         공모전 사무국 답변 "Android signature·privileged 권한은 사용할 수 없습니다" → signature|privileged 등급인
         CAR_ENGINE_DETAILED(ENGINE_RPM)·READ_CAR_STEERING(PERF_STEERING_ANGLE) 선언을 뺐다. 조향각은 Pleos SteeringWheel(CAR_DRIVE)로 받는다. -->
    <uses-permission android:name="android.car.permission.CAR_SPEED" />
    <uses-permission android:name="android.car.permission.CAR_POWERTRAIN" />
    <!-- 차종 인식: AAOS INFO_MAKE, INFO_MODEL 읽기(normal). 없으면 늘 기본 제원(아반떼)이었다 -->
    <uses-permission android:name="android.car.permission.CAR_INFO" />
    <!-- 액셀 페달 밟은 정도(ACCELERATOR_PEDAL_COMPRESSION_PERCENTAGE): 3D 게임 "실제 액셀" 모드. dangerous → 다른 android.car 권한과 함께 런타임 요청.
         이 권한·속성이 없는 기기에서는 거부되고 게임은 자동 속도(핸들만)로 달린다. -->
    <uses-permission android:name="android.car.permission.READ_CAR_PEDALS" />

    <!-- STT 는 Pleos 서비스가 차량 마이크를 쓰므로 RECORD_AUDIO 는 불필요(문서: sendAudio 는 대안 경로). 네트워크는 길찾기 API(네이버 Directions, 키를 넣은 빌드만) 용 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 진단용 QUERY_ALL_PACKAGES 는 제거. 진단 화면의 패키지 조회는 보이는 범위(queries 없이)만 보여 준다. -->

    <!-- ===== 포그라운드 서비스 (CoachService) =====
         에뮬레이터 확인: 기어 D 에서 Pleos 런처가 앱 화면을 덮어 Activity 가 멈춘다. 음성 코칭이 계속되도록 신호·코칭·TTS 를 서비스로 옮겼다.
         targetSdk 34 는 foregroundServiceType 이 필수. 차량 음성 안내는 표준 타입에 없어 specialUse + 설명 property 를 쓴다(스토어 제출 시 사유 기재 필요).
         POST_NOTIFICATIONS 는 API 33+ 런타임 권한. 거부돼도 서비스는 뜬다(알림만 안 보임). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Pleos 실험(설정 > 진단): 차량 서비스의 "허용 설치 출처" 설정을 읽으려면 패키지가 보여야 한다(Android 11+ 패키지 가시성). -->
    <queries>
        <package android:name="com.android.car" />
        <package android:name="com.android.car.updatable" />
        <package android:name="com.google.android.car.updatable" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <!-- Pleos CCP 가이드: 회전 다이얼(CCP)로 화면 포커스를 옮기는 조작은 지원하지 않는다(사용자 설치 앱은 선택). 필수 조작은 모두 터치·음성으로 끝난다. -->
        <meta-data android:name="com.hmg.rotary.ROTARY_SUPPORTED" android:value="false" />

        <!-- android.car 플랫폼 라이브러리 (CarPropertyManager, CarUxRestrictionsManager) -->
        <uses-library android:name="android.car" android:required="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout">
            <!-- 가로 고정을 풀었다(Pleos 설계 가이드: 세로형 디스플레이도 꽉 채우기, 레터박스·호환 모드 금지). 화면은 ui/Adaptive.kt 가 폭에 맞춰 배치한다.
                 방향·크기 변화는 Activity 를 다시 만들지 않고 Compose 가 다시 그린다(진행 중인 화면 유지). -->
            <!-- 주행 중에도 화면(한 줄 요약)을 유지하려면 DO 앱으로 선언한다. 실제 UX 제한은 CarUxRestrictions 로 앱이 직접 적용 -->
            <meta-data android:name="distractionOptimized" android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Gleo 음성 연동(Gleo Interface): assets/schema.json 의 함수 이름 = 인텐트 action. 처리·응답은 GleoActions.kt -->
            <intent-filter>
                <action android:name="LEARN_CAR_FEATURE" />
                <action android:name="START_PARKING_PRACTICE" />
                <action android:name="START_PRACTICE_COURSE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- 3D 주차·핸들 연습(Unity). 별도 프로세스(:game3d): Unity 는 화면을 닫을 때 자기 프로세스를 끝낸다.
             준비 신호가 제한 시간 안에 오지 않으면 안내를 띄우고 닫는다(Game3DActivity). Unity 가 빌드에 없으면 같은 이름의 대체 화면이 안내만 띄운다.
             Unity 권장값: 하드웨어 가속 끔(Unity 가 자기 화면을 직접 그림), 설정 변화에 다시 만들지 않음.
             Pleos 창 정책: 방향을 정하지 않으면 세로 반쪽 창으로 뜬다 → 가로 전용 게임으로(앱 영역 전체). -->
        <activity
            android:name=".game3d.Game3DActivity"
            android:process=":game3d"
            android:exported="false"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:hardwareAccelerated="false"
            android:resizeableActivity="true"
            android:configChanges="mcc|mnc|locale|touchscreen|keyboard|keyboardHidden|navigation|orientation|screenLayout|uiMode|screenSize|smallestScreenSize|fontScale|layoutDirection|density"
            android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen">
            <meta-data android:name="unityplayer.UnityActivity" android:value="true" />
        </activity>

        <!-- Unity AAR 이 함께 넣는 기본 화면 UnityPlayerActivity 는 exported=true 로 들어온다.
             그대로 두면 다른 앱이 이 화면을 메인 프로세스에서 바로 열 수 있다(P 확인·:game3d 분리·Unity 명령줄 extra "unity" 를 거치지 않음).
             우리는 Game3DActivity(위)로만 3D 를 연다 → 밖에서 열 수 없게 막는다. -->
        <activity
            android:name="com.unity3d.player.UnityPlayerActivity"
            android:exported="false"
            tools:replace="android:exported" />

        <!-- 코칭 본체. 화면(MainActivity)이 런처에 가려지거나 닫혀도 신호 구독·판정·TTS 를 계속한다. 앱 안에서만 쓰므로 exported=false -->
        <service
            android:name=".CoachService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="in-car driving coaching voice guidance" />
        </service>
    </application>

</manifest>
